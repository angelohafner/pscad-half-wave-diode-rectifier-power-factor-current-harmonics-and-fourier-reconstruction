  <definitions>
    <Definition classid="UserCmpDefn" name="PeakGate" url="" view="false" instances="0" date="0" id="1899000001">
      <paramlist>
        <param name="Description" value="60 to 120 degree gate on a 60 Hz sinusoidal source" />
      </paramlist>
      <form name="Firing pulse" w="420" h="350" splitter="70">
        <category name="Configuration" visible="true">
          <parameter name="Name" desc="Name" type="Text" allowemptystr="true">
            <value>Gate_60_120</value>
            <cond type="Enable">true</cond>
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Fortran" classid="CoreSegment" id="1899000002">#LOCAL REAL ANGLE
      ANGLE = MODULO(TIME*21600.0,360.0)
      $GATE = 0
      IF (ANGLE .GE. 60.0 .AND. ANGLE .LT. 120.0) $GATE = 1
      $GREAL = REAL($GATE)
</segment>
      </script>
      <graphics size="4">
        <paramlist>
          <param name="show_border" value="0" />
          <param name="show_grid" value="0" />
          <param name="size" value="0" />
          <param name="orient" value="1" />
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
        <Gfx classid="Graphics.Rectangle" id="1899000011" x="-72" y="-36" w="144" h="72">
          <paramlist>
            <param name="color" value="Black" />
            <param name="dasharray" value="0" />
            <param name="thickness" value="0" />
            <param name="port" value="" />
            <param name="fill_style" value="1" />
            <param name="fill_fg" value="#fff0f5fa" />
            <param name="fill_bg" value="Transparent" />
            <param name="cond" value="true" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1899000012" x="0" y="0">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="1" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="60-120 deg" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="angle" value="0" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <Port id="1899000021" classid="Port" x="90" y="-18">
          <paramlist>
            <param name="name" value="GATE" />
            <param name="internal" value="false" />
            <param name="cond" value="true" />
            <param name="mode" value="2" />
            <param name="datatype" value="2" />
            <param name="electype" value="0" />
            <param name="dim" value="1" />
          </paramlist>
        </Port>
        <Port id="1899000023" classid="Port" x="90" y="18">
          <paramlist>
            <param name="name" value="GREAL" />
            <param name="internal" value="false" />
            <param name="cond" value="true" />
            <param name="mode" value="2" />
            <param name="datatype" value="3" />
            <param name="electype" value="0" />
            <param name="dim" value="1" />
          </paramlist>
        </Port>
      </graphics>
    </Definition>
